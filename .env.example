# ------------------------------------------------------------------------------
# Nourish - Food Analyzer Environment Variables
# ------------------------------------------------------------------------------
# NEVER commit real secret values to version control.
# Copy this file to .env.local for local development.

# Application Data Mode ("demo" | "live")
# - "demo": Runs offline browser storage client without external credentials.
# - "live": Connects to authenticated Next.js backend and Convex database.
NEXT_PUBLIC_DATA_MODE=demo

# Convex Database Configuration
# Obtain from your Convex dashboard: https://dashboard.convex.dev
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk Authentication Configuration
# Obtain from your Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer-domain.clerk.accounts.dev

# Server & Upstream Configuration
# Port and base URL
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Logging & Observability
# Log levels: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Required on the Next.js SERVER and in the same Convex deployment environment.
# Generate a random value of at least 32 characters and enter it securely in both.
# Never use a NEXT_PUBLIC_ prefix or put this value in client requests/logs.
NOURISH_BACKEND_SECRET=

# Person 4: server-only OpenAI recognition credentials.
# Used only by live analysis; browser demo does not call paid services.
RECOGNITION_API_KEY=
RECOGNITION_MODEL=gpt-4.1-mini

# Personal-use access: Clerk user ID of the only account allowed to use the API.
# Obtain from Clerk Dashboard > Users. No automatic first-user enrollment.
PERSONAL_USER_ID=
# Your exact app origin, e.g. http://localhost:3000 locally, HTTPS when hosted.
APP_ORIGIN=http://localhost:3000
# Manual logging is enabled by default; AI is optional and off.
ENABLE_AI=false
NEXT_PUBLIC_ENABLE_AI=false
